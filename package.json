{
  "name": "agilefocus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate-schemas": "node scripts/validate-schemas.js",
    "deploy": "vite build && echo '✓ Build complete. Deploy by pushing the dist/ folder to the gh-pages branch:\n  git subtree push --prefix dist origin gh-pages'"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@vitest/coverage-v8": "^4.1.6",
    "@xmldom/xmldom": "^0.9.10",
    "ajv": "^8.20.0",
    "jsdom": "^29.1.1",
    "svelte": "^4.2.20",
    "vite": "^5.4.21",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "bpmn-js": "^18.16.1",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1"
  }
}
