{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agilefocus.github.io/schemas/persona.schema.json",
  "type": "object",
  "title": "Persona",
  "description": "A stakeholder persona for the AgileFocus simulation engine",
  "required": [
    "id", "name", "role", "organisation_type", "agenda",
    "communication_style", "knowledge_boundary", "triggers",
    "conflict_with", "responses", "byok_system_prompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "description": "Display name"
    },
    "role": {
      "type": "string",
      "minLength": 2,
      "description": "Job title / role"
    },
    "organisation_type": {
      "type": "string",
      "enum": [
        "challenger_bank",
        "high_street_bank",
        "fintech",
        "insurer",
        "government",
        "regulator",
        "nhs",
        "consultancy",
        "retail_bank",
        "investment_bank",
        "building_society",
        "payment_provider",
        "central_government",
        "tier1_bank",
        "mutual_society",
        "healthcare"
      ],
      "description": "Type of organisation the persona belongs to"
    },
    "agenda": {
      "type": "string",
      "minLength": 10,
      "description": "Personal agenda / motivation"
    },
    "communication_style": {
      "type": "string",
      "enum": [
        "deadline_obsessed",
        "risk_averse",
        "detail_oriented",
        "diplomatic",
        "direct",
        "technical",
        "executive_summary",
        "regulatory_precise",
        "politically_cautious",
        "technically_aggressive",
        "relationship_first",
        "formal_data_driven",
        "audit_minded",
        "collaborative",
        "authoritative",
        "analytical",
        "strategic"
      ],
      "description": "How this persona communicates"
    },
    "knowledge_boundary": {
      "type": "object",
      "required": ["misunderstands", "triggers_on"],
      "properties": {
        "misunderstands": { "type": "string", "minLength": 10 },
        "triggers_on": { "type": "string", "minLength": 10 }
      },
      "description": "What the persona misunderstands and what triggers them"
    },
    "trust_score_initial": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "default": 50,
      "description": "Initial trust score (0-100)"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["condition", "response_key", "trust_delta"],
        "properties": {
          "condition": { "type": "string", "minLength": 3 },
          "response_key": { "type": "string", "minLength": 1 },
          "trust_delta": { "type": "integer", "minimum": -30, "maximum": 30 },
          "cascade_state_change": {
            "type": "object"
          }
        }
      },
      "description": "Trigger conditions that change trust and state"
    },
    "conflict_with": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Persona IDs or roles this persona conflicts with"
    },
    "responses": {
      "type": "object",
      "minProperties": 2,
      "patternProperties": {
        "^[a-zA-Z_]+$": { "type": "string", "minLength": 5 }
      },
      "description": "Pre-scripted responses (min 5 keys including fallback)"
    },
    "byok_system_prompt": {
      "type": "string",
      "minLength": 10,
      "description": "System prompt for BYOK AI persona mode"
    }
  }
}
