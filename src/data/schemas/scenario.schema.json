{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agilefocus.github.io/schemas/scenario.schema.json",
  "type": "object",
  "title": "Scenario",
  "description": "A multi-sprint simulation scenario for the AgileFocus simulator",
  "required": [
    "id", "title", "level_required", "context", "sprints",
    "personas_active", "success_criteria", "debrief_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Display title"
    },
    "level_required": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4,
      "description": "Minimum user level required to access this scenario"
    },
    "context": {
      "type": "object",
      "required": ["organisation", "regulatory_context", "team_composition"],
      "properties": {
        "organisation": {
          "type": "object",
          "required": ["name", "type", "regulator", "pci_dss_scope"],
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "type": { "type": "string", "minLength": 2 },
            "founded": { "type": "integer" },
            "customers": { "type": "integer", "minimum": 0 },
            "regulator": { "type": "string", "minLength": 2 },
            "authorisation_status": { "type": "string" },
            "channel": { "type": "string" },
            "pci_dss_scope": { "type": "boolean" }
          }
        },
        "regulatory_context": {
          "type": "string",
          "minLength": 20,
          "description": "Regulatory backdrop for the scenario"
        },
        "team_composition": {
          "type": "object",
          "required": ["developers", "qa", "ba", "product_owner"],
          "properties": {
            "developers": { "type": "integer", "minimum": 1 },
            "qa": { "type": "integer", "minimum": 0 },
            "ba": { "type": "integer", "minimum": 0 },
            "product_owner": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "description": "Scenario context including organisation and regulatory backdrop"
    },
    "personas_active": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "description": "Persona IDs active in this scenario (min 2)"
    },
    "sprints": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["sprint_number", "goal", "duration_days", "initial_backlog", "injected_events", "available_decisions"],
        "properties": {
          "sprint_number": { "type": "integer", "minimum": 1 },
          "goal": { "type": "string", "minLength": 5 },
          "duration_days": { "type": "integer", "minimum": 1 },
          "initial_backlog": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "points", "type"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "type": "string", "minLength": 5 },
                "points": { "type": "integer", "minimum": 1 },
                "type": { "type": "string", "enum": ["regulatory", "business"] },
                "description": { "type": "string" },
                "modified": { "type": "boolean" },
                "injected": { "type": "boolean" }
              }
            },
            "description": "Initial sprint backlog (min 1 story, additional injected via events)"
          },
          "injected_events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["decision", "state_change", "persona_event", "deadline_change"] },
                "decisionId": { "type": "string" },
                "description": { "type": "string" },
                "stateChanges": { "type": "object" },
                "personaEvents": { "type": "array", "items": { "type": "object" } },
                "day": { "type": "integer" }
              }
            }
          },
          "available_decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "description", "options"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "trigger": { "type": "string" },
                "title": { "type": "string", "minLength": 3 },
                "description": { "type": "string", "minLength": 10 },
                "options": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "description", "risk", "state_changes"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "label": { "type": "string", "minLength": 2 },
                      "description": { "type": "string", "minLength": 10 },
                      "risk": { "type": "string", "enum": ["low", "medium", "high"] },
                      "state_changes": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "Array of sprints (min 3)"
    },
    "success_criteria": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "description", "weight"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 10 },
          "weight": { "type": "number", "minimum": 0, "maximum": 10 }
        }
      },
      "description": "Weighted success criteria (min 3)"
    },
    "debrief_notes": {
      "anyOf": [
        { "type": "object", "minProperties": 1 },
        { "type": "string", "minLength": 10 }
      ],
      "description": "Debrief notes — object keyed by persona ID, or string summary"
    }
  }
}
