{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agilefocus.github.io/schemas/knowledge-check.schema.json",
  "type": "array",
  "title": "Knowledge Checks",
  "description": "An array of knowledge check questions for certification quizzes",
  "items": {
    "type": "object",
    "required": [
      "id", "certification_id", "domain_id", "question",
      "options", "correct_index", "explanation", "difficulty"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Unique question identifier"
      },
      "certification_id": {
        "type": "string",
        "minLength": 2,
        "description": "ID of the certification this question belongs to"
      },
      "domain_id": {
        "type": "string",
        "minLength": 2,
        "description": "Domain/area within the certification"
      },
      "question": {
        "type": "string",
        "minLength": 10,
        "description": "The question text"
      },
      "options": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "string", "minLength": 1 },
        "description": "Exactly 4 answer options"
      },
      "correct_index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3,
        "description": "Index of the correct answer (0-3)"
      },
      "explanation": {
        "type": "string",
        "minLength": 10,
        "description": "Explanation of the correct answer"
      },
      "difficulty": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "description": "Difficulty level (1=easy, 2=medium, 3=hard)"
      }
    }
  }
}
