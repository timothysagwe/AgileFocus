<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_IT" name="IT">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitRequest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Risk" name="Risk">
        <bpmn:flowNodeRef>Task_RiskAssessment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RiskDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CAB" name="Change Advisory Board">
        <bpmn:flowNodeRef>SubProcess_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CABDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Change Requested">
      <bpmn:outgoing>Flow_StartToSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SubmitRequest" name="Submit Change Request">
      <bpmn:incoming>Flow_StartToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToRisk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_RiskAssessment" name="Assess Risk">
      <bpmn:incoming>Flow_SubmitToRisk</bpmn:incoming>
      <bpmn:outgoing>Flow_RiskToDecision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RiskDecision" name="Risk Approved?" default="Flow_RiskRejected">
      <bpmn:incoming>Flow_RiskToDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_RiskApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_RiskRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RiskApproved" name="Approved" sourceRef="Gateway_RiskDecision" targetRef="SubProcess_Review" />
    <bpmn:sequenceFlow id="Flow_RiskRejected" name="Rejected" sourceRef="Gateway_RiskDecision" targetRef="EndEvent_1" />
    <bpmn:subProcess id="SubProcess_Review" name="CAB Review">
      <bpmn:incoming>Flow_RiskApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToCABDecision</bpmn:outgoing>
      <bpmn:startEvent id="SP_Start">
        <bpmn:outgoing>SP_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="SP_ReviewChange" name="Review Change Details">
        <bpmn:incoming>SP_Flow_1</bpmn:incoming>
        <bpmn:outgoing>SP_Flow_2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SP_End">
        <bpmn:incoming>SP_Flow_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_Flow_1" sourceRef="SP_Start" targetRef="SP_ReviewChange" />
      <bpmn:sequenceFlow id="SP_Flow_2" sourceRef="SP_ReviewChange" targetRef="SP_End" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryError_Review" attachedToRef="SubProcess_Review">
      <bpmn:errorEventDefinition />
      <bpmn:outgoing>Flow_ErrorToEnd</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ErrorToEnd" sourceRef="BoundaryError_Review" targetRef="EndEvent_1" />
    <bpmn:exclusiveGateway id="Gateway_CABDecision" name="CAB Approved?" default="Flow_CABRejected">
      <bpmn:incoming>Flow_ReviewToCABDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_CABApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_CABRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CABApproved" name="Approved" sourceRef="Gateway_CABDecision" targetRef="Task_RecordApproval" />
    <bpmn:sequenceFlow id="Flow_CABRejected" name="Rejected" sourceRef="Gateway_CABDecision" targetRef="EndEvent_1" />
    <bpmn:task id="Task_RecordApproval" name="Record Approval (Audit)">
      <bpmn:incoming>Flow_CABApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordToEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Change Processed">
      <bpmn:incoming>Flow_RiskRejected</bpmn:incoming>
      <bpmn:incoming>Flow_ErrorToEnd</bpmn:incoming>
      <bpmn:incoming>Flow_CABRejected</bpmn:incoming>
      <bpmn:incoming>Flow_RecordToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToSubmit" sourceRef="StartEvent_1" targetRef="Task_SubmitRequest" />
    <bpmn:sequenceFlow id="Flow_SubmitToRisk" sourceRef="Task_SubmitRequest" targetRef="Task_RiskAssessment" />
    <bpmn:sequenceFlow id="Flow_RiskToDecision" sourceRef="Task_RiskAssessment" targetRef="Gateway_RiskDecision" />
    <bpmn:sequenceFlow id="Flow_ReviewToCABDecision" sourceRef="SubProcess_Review" targetRef="Gateway_CABDecision" />
    <bpmn:sequenceFlow id="Flow_RecordToEnd" sourceRef="Task_RecordApproval" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="156" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SubmitRequest_di" bpmnElement="Task_SubmitRequest">
        <dc:Bounds x="250" y="60" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RiskAssessment_di" bpmnElement="Task_RiskAssessment">
        <dc:Bounds x="410" y="195" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RiskDecision_di" bpmnElement="Gateway_RiskDecision">
        <dc:Bounds x="570" y="210" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Review_di" bpmnElement="SubProcess_Review">
        <dc:Bounds x="680" y="190" width="180" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CABDecision_di" bpmnElement="Gateway_CABDecision">
        <dc:Bounds x="920" y="210" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordApproval_di" bpmnElement="Task_RecordApproval">
        <dc:Bounds x="1030" y="60" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1200" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToSubmit_di" bpmnElement="Flow_StartToSubmit">
        <di:waypoint x="192" y="100" />
        <di:waypoint x="250" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SubmitToRisk_di" bpmnElement="Flow_SubmitToRisk">
        <di:waypoint x="350" y="100" />
        <di:waypoint x="350" y="235" />
        <di:waypoint x="410" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RiskToDecision_di" bpmnElement="Flow_RiskToDecision">
        <di:waypoint x="510" y="235" />
        <di:waypoint x="570" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RiskApproved_di" bpmnElement="Flow_RiskApproved">
        <di:waypoint x="620" y="235" />
        <di:waypoint x="680" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RiskRejected_di" bpmnElement="Flow_RiskRejected">
        <di:waypoint x="595" y="260" />
        <di:waypoint x="595" y="320" />
        <di:waypoint x="1218" y="320" />
        <di:waypoint x="1218" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ReviewToCABDecision_di" bpmnElement="Flow_ReviewToCABDecision">
        <di:waypoint x="860" y="235" />
        <di:waypoint x="920" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CABApproved_di" bpmnElement="Flow_CABApproved">
        <di:waypoint x="945" y="210" />
        <di:waypoint x="945" y="100" />
        <di:waypoint x="1030" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CABRejected_di" bpmnElement="Flow_CABRejected">
        <di:waypoint x="970" y="235" />
        <di:waypoint x="1218" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RecordToEnd_di" bpmnElement="Flow_RecordToEnd">
        <di:waypoint x="1160" y="100" />
        <di:waypoint x="1200" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
